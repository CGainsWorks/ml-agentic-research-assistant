# Copy to .env and edit. Every value has a working default — the stack runs
# with no .env at all. Nothing here is required to reproduce the README numbers.

# ---------------------------------------------------------------- generation
# ollama (default) | openai_compat | fixture
ARAA_LLM_BACKEND=ollama

# --- ollama: open-source weights, local, no API key, no cost --------------
# Inside docker compose this is set to http://ollama:11434 automatically.
# To use an Ollama you already run on the host instead of the bundled one:
#   ARAA_OLLAMA_BASE_URL=http://host.docker.internal:11434
ARAA_OLLAMA_BASE_URL=http://localhost:11434
# This pipeline makes 4-6 short structured calls per question (a plan, a tool
# line, a verdict), so a reasoning model spends a large token budget thinking
# before emitting three words. Reasoning models still work - see below.
ARAA_OLLAMA_MODEL=llama3.1:8b
# qwen3/deepseek-r1 emit <think>...</think> before the answer. Left in, the
# citation parser reads the deliberation as factual claims.
ARAA_OLLAMA_DISABLE_THINKING=true

# NOTE ON SPEED: if the model does not fit in VRAM, Ollama silently falls back
# to CPU and a 3k-token prompt goes from seconds to minutes. Measured on the dev
# box for this project: 73s for a full agent run with the GPU free, 295s for the
# same run with the GPU occupied by other processes. Check with `ollama ps` -
# the PROCESSOR column says which it used.

# --- openai_compat: any OpenAI-compatible chat completions server ----------
# OpenAI, vLLM, llama.cpp server, LM Studio, a gateway or Ollama's own /v1
# route. The default URL is the local Ollama, so nothing leaves the machine
# until you point it somewhere else on purpose. To switch:
#   ARAA_LLM_BACKEND=openai_compat
# Examples:
#   vLLM on a box in your network:  ARAA_OPENAI_BASE_URL=http://gpu-box:8000/v1
#   OpenAI:                         ARAA_OPENAI_BASE_URL=https://api.openai.com/v1
# Inside docker compose the default is http://ollama:11434/v1 (the bundled one).
ARAA_OPENAI_BASE_URL=http://localhost:11434/v1
ARAA_OPENAI_MODEL=llama3.1:8b
# The NAME of the environment variable holding the API key, not the key itself.
# Local servers usually need no key: leave the variable unset.
ARAA_OPENAI_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=
# USD per million tokens, used for cost accounting. Leave at 0 for self-hosted
# models; copy the provider's price list for a hosted one.
ARAA_OPENAI_INPUT_USD_PER_MTOK=0.0
ARAA_OPENAI_OUTPUT_USD_PER_MTOK=0.0

ARAA_TEMPERATURE=0.0
ARAA_MAX_OUTPUT_TOKENS=900
# Generous: a CPU fallback turns a 20s answer into a 4-minute one, and a
# timeout there is the wrong failure.
ARAA_REQUEST_TIMEOUT_S=600

# ------------------------------------------------------- embeddings/rerank
ARAA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ARAA_RERANKER_MODEL=BAAI/bge-reranker-base
ARAA_USE_RERANKER=true

# ------------------------------------------------------------------ chunking
# fixed | recursive | sentence_window | section_aware
ARAA_CHUNK_STRATEGY=recursive
ARAA_CHUNK_SIZE=900
ARAA_CHUNK_OVERLAP=150

# ----------------------------------------------------------------- retrieval
ARAA_VECTOR_TOP_K=30
ARAA_BM25_TOP_K=30
ARAA_RRF_K=60
ARAA_FUSED_TOP_K=20
ARAA_FINAL_TOP_K=6
# Prompt-evaluation time dominates on CPU and scales with context length.
# 1200 x 6 is ~1.9k tokens of evidence. Raise it when running on a GPU.
ARAA_MAX_CONTEXT_CHARS_PER_CHUNK=1200

# --------------------------------------------------------------------- agent
ARAA_MAX_PLAN_STEPS=4
ARAA_MAX_CRITIQUE_ROUNDS=2
ARAA_MAX_TOOL_CALLS=8

# ---------------------------------------------------------------- guardrails
ARAA_GUARDRAILS_ENABLED=true
ARAA_GUARDRAIL_BLOCK_ON_DETECT=true

# ------------------------------------------------------------------ ingestion
ARAA_INGEST_ENABLED=false
ARAA_INGEST_CRON=15 3 * * *
ARAA_CORPUS_TARGET_DOCS=200
